<?xml version="1.0" encoding="UTF-8"?>
<Defs>

	<AlienRace.RaceSettings>
		<defName>Pony_BodyAddons_Races</defName>

		<universalBodyAddons>

		<!-- Zebra mark -->
			<li>
				<name>Cutiemark</name>
				<path>Races/Cutiemarks/QTMark_Zebra</path>
				<inFrontOfBody>true</inFrontOfBody>
				<drawSize>(0.15, 0.15)</drawSize>
				<scaleWithPawnDrawsize>true</scaleWithPawnDrawsize>
				<colorChannel>skin</colorChannel>
				<conditions>
					<RotStage>Fresh,Rotting</RotStage>
					<Or>
						<Race>Pony_Zebra</Race>
					</Or>
					<Or>
						<Age>PonyAdult</Age>
						<Age>PonyTeenager</Age>
						<Age>HumanlikeAdult</Age>
						<Age>HumanlikeTeenager</Age>
					</Or>
					<BodyPart>
						<bodyPart>Torso</bodyPart>
					</BodyPart>
					<Apparel>
						<hiddenUnderApparelFor>
							<li>Legs</li>
						</hiddenUnderApparelFor>
					</Apparel>
				</conditions>
				<extendedGraphics>
					<Mutant For="AwokenCorpse" MayRequire="Ludeon.RimWorld.Anomaly">Transparent/Transparent</Mutant>
				</extendedGraphics>
				<offsets>
					<east>
						<layerOffset>-0.295</layerOffset>
						<bodyTypes>
							<Pony>(0.22, -0.1)</Pony>
							<PonyBaby MayRequire="Ludeon.RimWorld.Biotech">(0.22, -0.1)</PonyBaby>
							<PonyChild MayRequire="Ludeon.RimWorld.Biotech">(0.22, -0.1)</PonyChild>
						</bodyTypes>
					</east>
				</offsets>
			</li>
		<!-- Head addon -->
			<li>
				<name>Head addon</name>
				<inFrontOfBody>true</inFrontOfBody>
				<alignWithHead>true</alignWithHead>
				<scaleWithPawnDrawsize>true</scaleWithPawnDrawsize>
				<colorChannel>skin</colorChannel>
				<conditions>
					<RotStage>Fresh,Rotting</RotStage>
					<Or>
						<Race>Pony_Kirin</Race>
					</Or>
					<BodyPart>
						<bodyPart>Torso</bodyPart>
					</BodyPart>
				</conditions>
				<extendedGraphics>
					<Race For="Pony_Kirin">Races/Addons/Kirin/Head_Scales</Race>
				</extendedGraphics>
				<offsets>
					<south>
						<layerOffset>-0.28</layerOffset>
					</south>
					<north>
						<layerOffset>-0.28</layerOffset>
					</north>
					<east>
						<layerOffset>-0.28</layerOffset>
					</east>
				</offsets>
			</li>
		<!-- Soul gem-->
			<li>
				<name>Soul gem</name>
				<inFrontOfBody>true</inFrontOfBody>
				<scaleWithPawnDrawsize>true</scaleWithPawnDrawsize>
				<colorChannel>skin</colorChannel>
				<conditions>
					<RotStage>Fresh,Rotting</RotStage>
					<Or>
						<Race>Pony_Changeling</Race>
						<Race>Pony_Changedling</Race>
					</Or>
					<BodyPart>
						<bodyPart>Torso</bodyPart>
					</BodyPart>
				</conditions>
				<extendedGraphics>
					<Race For="Pony_Changeling">Races/Addons/Changeling/SoulGem</Race>
					<Race For="Pony_Changedling">Races/Addons/Changeling/SoulGem</Race>
				</extendedGraphics>
				<offsets>
					<south>
						<layerOffset>-0.29</layerOffset>
					</south>
					<north>
						<layerOffset>-0.335</layerOffset>
					</north>
					<east>
						<layerOffset>-0.2905</layerOffset>
					</east>
				</offsets>
			</li>
		<!-- Body addon (skin)-->
			<li>
				<name>Body addon (skin)</name>
				<inFrontOfBody>true</inFrontOfBody>
				<scaleWithPawnDrawsize>true</scaleWithPawnDrawsize>
				<colorChannel>skin</colorChannel>
				<conditions>
					<RotStage>Fresh,Rotting</RotStage>
					<Or>
						<Race>Pony_Changeling</Race>
						<Race>Pony_Changedling</Race>
						<Race>Pony_Kirin</Race>
					</Or>
					<BodyPart>
						<bodyPart>Torso</bodyPart>
					</BodyPart>
				</conditions>
				<extendedGraphics>
					<Race For="Pony_Changeling">Races/Addons/Changeling/Chitin</Race>
					<Race For="Pony_Changedling">Races/Addons/Changeling/Chitin</Race>
					<Race For="Pony_Kirin">Races/Addons/Kirin/Body_Scales</Race>
				</extendedGraphics>
				<offsets>
					<south>
						<layerOffset>-0.295</layerOffset>
					</south>
					<north>
						<layerOffset>-0.305</layerOffset>
					</north>
					<east>
						<layerOffset>-0.295</layerOffset>
					</east>
				</offsets>
			</li>
		<!-- Body addon (optional) -->
			<li>
				<name>Body addon (optional)</name>
				<inFrontOfBody>true</inFrontOfBody>
				<scaleWithPawnDrawsize>true</scaleWithPawnDrawsize>
				<colorChannel>optional</colorChannel>
				<conditions>
					<RotStage>Fresh,Rotting</RotStage>
					<Or>
						<Race>Pony_Griffon</Race>
						<Race>Pony_Hippogriff</Race>
					</Or>
					<BodyPart>
						<bodyPart>Torso</bodyPart>
					</BodyPart>
				</conditions>
				<extendedGraphics>
					<Race For="Pony_Griffon">Races/Claws/Claws</Race>
					<Race For="Pony_Hippogriff">Races/Claws/Claws</Race>
				</extendedGraphics>
				<offsets>
					<south>
						<layerOffset>-0.295</layerOffset>
					</south>
					<north>
						<layerOffset>-0.305</layerOffset>
					</north>
					<east>
						<layerOffset>-0.295</layerOffset>
					</east>
				</offsets>
			</li>
		<!-- Kirin horn -->
			<li>
				<name>Horn</name>
				<path>Races/Horns/Kirin/Horn_Kirin</path>
				<userCustomizable>true</userCustomizable>
				<inFrontOfBody>true</inFrontOfBody>
				<alignWithHead>true</alignWithHead>
				<scaleWithPawnDrawsize>true</scaleWithPawnDrawsize>
				<colorChannel>optional</colorChannel>
				<conditions>
					<Or>
						<Race>Pony_Kirin</Race>
					</Or>
					<Or>
						<BodyPart>
							<bodyPart>Pony_Horn</bodyPart>
							<drawWithoutPart>true</drawWithoutPart>
						</BodyPart>
					</Or>
					<Apparel>
						<hiddenUnderApparelFor>
							<li>CoverHorn</li>
						</hiddenUnderApparelFor>
					</Apparel>
				</conditions>
				<extendedGraphics>
					<Hediff For="MissingBodyPart">Races/Horns/Broken/Horn_Broken</Hediff>
					<Hediff For="BionicHorn">Races/Horns/Bionic/Horn_Bionic</Hediff>
					<Hediff For="ArchotechHorn">Races/Horns/Archotech/Horn_Archotech</Hediff>
				</extendedGraphics>
				<offsets>
					<south>
						<layerOffset>-0.27</layerOffset>
					</south>
					<north>
						<layerOffset>-0.27</layerOffset>
					</north>
					<east>
						<layerOffset>-0.27</layerOffset>
					</east>
				</offsets>
			</li>
		<!-- Antlers -->
			<li>
				<name>Antlers</name>
				<path>Races/Horns/Antlers/Antlers_Male</path>
				<userCustomizable>true</userCustomizable>
				<inFrontOfBody>true</inFrontOfBody>
				<alignWithHead>true</alignWithHead>
				<scaleWithPawnDrawsize>true</scaleWithPawnDrawsize>
				<colorChannel>optional</colorChannel>
				<conditions>
					<Or>
						<Race>Pony_Deer</Race>
					</Or>
					<BodyPart>
						<bodyPart>Head</bodyPart>
					</BodyPart>
				</conditions>
				<offsets>
					<south>
						<layerOffset>-0.26</layerOffset>
					</south>
					<north>
						<layerOffset>-0.51</layerOffset>
					</north>
					<east>
						<layerOffset>-0.27</layerOffset>
					</east>
				</offsets>
				<extendedGraphics>
					<Gender For="Female">Races/Horns/Antlers/Antlers_Female</Gender>
				</extendedGraphics>
			</li>
		</universalBodyAddons>
	</AlienRace.RaceSettings>

</Defs>