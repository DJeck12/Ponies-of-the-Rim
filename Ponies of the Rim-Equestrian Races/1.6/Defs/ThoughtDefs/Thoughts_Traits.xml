<?xml version="1.0" encoding="UTF-8"?>
<Defs>

	<ThoughtDef>
		<defName>Pony_Sylvanist_Mood</defName>
		<workerClass>PoniesOfTheRim.Thoughts.ThoughtWorker_Pony_Sylvanist</workerClass>
		<stages>
			<li>
				<label>in a forest</label>
				<description>I love being in places where I can admire green, living nature.</description>
				<baseMoodEffect>3</baseMoodEffect>
			</li>
			<li>
				<label>outside a forest</label>
				<description>I'm so far from a forest... I can't stand this dry wasteland.</description>
				<baseMoodEffect>-6</baseMoodEffect>
			</li>
		</stages>
		<modExtensions>
			<li Class="PoniesOfTheRim.Thoughts.SylvanistExtension">
				<forestBiomes>
					<li>BorealForest</li>
					<li>TemperateForest</li>
					<li>TropicalRainforest</li>
					<li>TemperateSwamp</li>
					<li>TropicalSwamp</li>
				</forestBiomes>
			</li>
		</modExtensions>
	</ThoughtDef>

</Defs>