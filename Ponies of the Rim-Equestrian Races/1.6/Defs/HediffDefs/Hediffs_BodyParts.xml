			<li>
				<filter>
					<thingDefs>
						<li>Pony_ChangelingHorn</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
		<thingDefs>
			<li>Pony_ChangelingHorn</li>
		</thingDefs>
		</fixedIngredientFilter>
		<appliedOnFixedBodyParts>
			<li>Pony_ChangelingHorn</li>
		</appliedOnFixedBodyParts>
	</RecipeDef>


