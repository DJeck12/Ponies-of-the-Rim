<?xml version="1.0" encoding="UTF-8"?>
<Defs>

<!-- Issue -->

	<IssueDef>
		<defName>Pony_Alicorn</defName>
		<label>alicorns</label>
		<iconPath>UI/Issues/Alicorn</iconPath>
	</IssueDef>

<!-- Precepts -->

<!-- Abhorrent -->

	<PreceptDef>
		<defName>Pony_Alicorn_Abhorrent</defName>
		<issue>Pony_Alicorn</issue>
		<label>abhorrent</label>
		<description>Alicorns are an inferior race, not worthy of our attention. We shouldn't even think about being friends with them.</description>
		<impact>Medium</impact>
		<displayOrderInIssue>60</displayOrderInIssue>
		<conflictingMemes>
			<li>Pony_Friendship</li>
		</conflictingMemes>
		<comps>
			<li Class="PreceptComp_SituationalThought">
				<thought>Pony_Alicorn_Abhorrent</thought>
			</li>
			<li Class="PreceptComp_SituationalThought">
				<thought>Pony_Alicorn_Abhorrent_Social</thought>
			</li>
		</comps>
	</PreceptDef>

	<ThoughtDef>
		<defName>Pony_Alicorn_Abhorrent</defName>
		<thoughtClass>Thought_Situational</thoughtClass>
		<workerClass>PoniesOfTheRim.Thoughts.ThoughtWorker_Precept_Races</workerClass>
		<stages>
			<li>
				<label>hatred for alicorns</label>
				<description>Alicorns are absolutely repulsive and I can't let them abuse our trust.</description>
				<baseMoodEffect>-5</baseMoodEffect>
			</li>
		</stages>
		<modExtensions>
			<li Class="VEF.Pawns.ThoughtExtensions">
				<removeThoughtsWhenAdded>
					<li>Pony_Everypony_Abhorrent</li>
					<li>HAR_AlienRaces_Abhorrent</li>
				</removeThoughtsWhenAdded>
			</li>
			<li Class="PoniesOfTheRim.Thoughts.ThoughtExtension">
				<race>Pony_Alicorn</race>
			</li>
		</modExtensions>
	</ThoughtDef>

	<ThoughtDef>
		<defName>Pony_Alicorn_Abhorrent_Social</defName>
		<thoughtClass>Thought_SituationalSocial</thoughtClass>
		<workerClass>PoniesOfTheRim.Thoughts.ThoughtWorker_Precept_Races_Social</workerClass>
		<stages>
			<li>
				<label>disgusting alicorn!</label>
				<baseOpinionOffset>-20</baseOpinionOffset>
			</li>
		</stages>
		<modExtensions>
			<li Class="VEF.Pawns.ThoughtExtensions">
				<removeThoughtsWhenAdded>
					<li>Pony_Everypony_Abhorrent_Social</li>
					<li>HAR_AlienRaces_Abhorrent_Social</li>
				</removeThoughtsWhenAdded>
			</li>
			<li Class="PoniesOfTheRim.Thoughts.ThoughtExtension">
				<race>Pony_Alicorn</race>
			</li>
		</modExtensions>
	</ThoughtDef>

<!-- Horrible -->

	<PreceptDef>
		<defName>Pony_Alicorn_Horrible</defName>
		<issue>Pony_Alicorn</issue>
		<label>disliked</label>
		<description>Alicorns are different from us, even too different. We have to be on our guard and not trust them.</description>
		<impact>Low</impact>
		<displayOrderInIssue>50</displayOrderInIssue>
		<comps>
			<li Class="PreceptComp_SituationalThought">
				<thought>Pony_Alicorn_Horrible_Social</thought>
			</li>
		</comps>
	</PreceptDef>

	<ThoughtDef>
		<defName>Pony_Alicorn_Horrible_Social</defName>
		<thoughtClass>Thought_SituationalSocial</thoughtClass>
		<workerClass>PoniesOfTheRim.Thoughts.ThoughtWorker_Precept_Races_Social</workerClass>
		<stages>
			<li>
				<label>distrust for alicorns</label>
				<baseOpinionOffset>-10</baseOpinionOffset>
			</li>
		</stages>
		<modExtensions>
			<li Class="VEF.Pawns.ThoughtExtensions">
				<removeThoughtsWhenAdded>
					<li>Pony_Everypony_Horrible_Social</li>
					<li>HAR_AlienRaces_Horrible_Social</li>
				</removeThoughtsWhenAdded>
			</li>
			<li Class="PoniesOfTheRim.Thoughts.ThoughtExtension">
				<race>Pony_Alicorn</race>
			</li>
		</modExtensions>
	</ThoughtDef>

<!-- Stricted -->

	<PreceptDef>
		<defName>Pony_Alicorn_Stricted</defName>
		<issue>Pony_Alicorn</issue>
		<label>stricted</label>
		<description>Alicorns are the only race allowed in our society.</description>
		<impact>High</impact>
		<displayOrderInIssue>30</displayOrderInIssue>
		<requiredMemes>
			<li>Pony_AlicornSupremacist</li>
		</requiredMemes>
		<comps>
			<li Class="PreceptComp_SituationalThought">
				<thought>Pony_Alicorn_Stricted</thought>
			</li>
			<li Class="PreceptComp_SituationalThought">
				<thought>Pony_Alicorn_Stricted_Social</thought>
			</li>
		</comps>
	</PreceptDef>

	<ThoughtDef>
		<defName>Pony_Alicorn_Stricted</defName>
		<workerClass>PoniesOfTheRim.Thoughts.ThoughtWorker_Precept_StrictRaces</workerClass>
		<thoughtClass>Thought_Situational</thoughtClass>
		<stages>
			<li>
				<label>other races among us</label>
				<description>We live alongside someone who is not an alicorn. We should make them leave in one way or another.</description>
				<baseMoodEffect>-15</baseMoodEffect>
			</li>
		</stages>
		<modExtensions>
			<li Class="PoniesOfTheRim.Thoughts.ThoughtExtension">
				<race>Pony_Alicorn</race>
			</li>
		</modExtensions>
	</ThoughtDef>

	<ThoughtDef>
		<defName>Pony_Alicorn_Stricted_Social</defName>
		<thoughtClass>Thought_SituationalSocial</thoughtClass>
		<workerClass>PoniesOfTheRim.Thoughts.ThoughtWorker_Precept_StrictRaces_Social</workerClass>
		<stages>
			<li>
				<label>not an alicorn</label>
				<baseOpinionOffset>-50</baseOpinionOffset>
			</li>
		</stages>
		<modExtensions>
			<li Class="PoniesOfTheRim.Thoughts.ThoughtExtension">
				<race>Pony_Alicorn</race>
			</li>
		</modExtensions>
	</ThoughtDef>

<!-- Respected -->

	<PreceptDef>
		<defName>Pony_Alicorn_Respected</defName>
		<issue>Pony_Alicorn</issue>
		<label>respected</label>
		<description>Alicorns are very unique and deserve our admiration.</description>
		<impact>Low</impact>
		<displayOrderInIssue>10</displayOrderInIssue>
		<conflictingMemes>
			<li>Pony_EarthponySupremacist</li>
			<li>Pony_PegasusSupremacist</li>
			<li>Pony_UnicornSupremacist</li>
			<li>Pony_BatponySupremacist</li>
			<li>Pony_ChangelingSupremacist</li>
			<li>Pony_ChangedlingSupremacist</li>
			<li>Pony_CrystalponySupremacist</li>
			<li>Pony_DeerSupremacist</li>
			<li>Pony_GriffonSupremacist</li>
			<li>Pony_HippogriffSupremacist</li>
			<li>Pony_KirinSupremacist</li>
			<li>Pony_SeaponySupremacist</li>
			<li>Pony_ZebraSupremacist</li>
		</conflictingMemes>
		<comps>
			<li Class="PreceptComp_SituationalThought">
				<thought>Pony_Alicorn_Respected_Social</thought>
			</li>
		</comps>
	</PreceptDef>

	<ThoughtDef>
		<defName>Pony_Alicorn_Respected_Social</defName>
		<thoughtClass>Thought_SituationalSocial</thoughtClass>
		<workerClass>PoniesOfTheRim.Thoughts.ThoughtWorker_Precept_Races_Social</workerClass>
		<stages>
			<li>
				<label>respect for alicorns</label>
				<baseOpinionOffset>10</baseOpinionOffset>
			</li>
		</stages>
		<modExtensions>
			<li Class="VEF.Pawns.ThoughtExtensions">
				<removeThoughtsWhenAdded>
					<li>Pony_Everypony_Respected_Social</li>
					<li>HAR_AlienRaces_Respected_Social</li>
				</removeThoughtsWhenAdded>
			</li>
			<li Class="PoniesOfTheRim.Thoughts.ThoughtExtension">
				<race>Pony_Alicorn</race>
			</li>
		</modExtensions>
	</ThoughtDef>

<!-- Exalted -->

	<PreceptDef>
		<defName>Pony_Alicorn_Exalted</defName>
		<issue>Pony_Alicorn</issue>
		<label>exalted</label>
		<description>Alicorns are delightful creatures, it is our responsibility to treat them with the respect they deserve.</description>
		<impact>Medium</impact>
		<displayOrderInIssue>0</displayOrderInIssue>
		<conflictingMemes>
			<li>Pony_EarthponySupremacist</li>
			<li>Pony_PegasusSupremacist</li>
			<li>Pony_UnicornSupremacist</li>
			<li>Pony_BatponySupremacist</li>
			<li>Pony_ChangelingSupremacist</li>
			<li>Pony_ChangedlingSupremacist</li>
			<li>Pony_CrystalponySupremacist</li>
			<li>Pony_DeerSupremacist</li>
			<li>Pony_GriffonSupremacist</li>
			<li>Pony_HippogriffSupremacist</li>
			<li>Pony_KirinSupremacist</li>
			<li>Pony_SeaponySupremacist</li>
			<li>Pony_ZebraSupremacist</li>
		</conflictingMemes>
		<comps>
			<li Class="PreceptComp_SituationalThought">
				<thought>Pony_Alicorn_Exalted</thought>
			</li>
			<li Class="PreceptComp_SituationalThought">
				<thought>Pony_Alicorn_Exalted_Social</thought>
			</li>
		</comps>
	</PreceptDef>

	<ThoughtDef>
		<defName>Pony_Alicorn_Exalted</defName>
		<workerClass>PoniesOfTheRim.Thoughts.ThoughtWorker_Precept_Races</workerClass>
		<thoughtClass>Thought_Situational</thoughtClass>
		<stages>
			<li>
				<label>love for alicorns</label>
				<description>It makes me feel happier knowing we live among alicorns.</description>
				<baseMoodEffect>3</baseMoodEffect>
			</li>
		</stages>
		<modExtensions>
			<li Class="VEF.Pawns.ThoughtExtensions">
				<removeThoughtsWhenAdded>
					<li>Pony_Everypony_Exalted</li>
					<li>HAR_AlienRaces_Exalted</li>
				</removeThoughtsWhenAdded>
			</li>
			<li Class="PoniesOfTheRim.Thoughts.ThoughtExtension">
				<race>Pony_Alicorn</race>
			</li>
		</modExtensions>
	</ThoughtDef>

	<ThoughtDef>
		<defName>Pony_Alicorn_Exalted_Social</defName>
		<thoughtClass>Thought_SituationalSocial</thoughtClass>
		<workerClass>PoniesOfTheRim.Thoughts.ThoughtWorker_Precept_Races_Social</workerClass>
		<stages>
			<li>
				<label>amazing alicorn!</label>
				<baseOpinionOffset>20</baseOpinionOffset>
			</li>
		</stages>
		<modExtensions>
			<li Class="VEF.Pawns.ThoughtExtensions">
				<removeThoughtsWhenAdded>
					<li>Pony_Everypony_Exalted_Social</li>
					<li>HAR_AlienRaces_Exalted_Social</li>
				</removeThoughtsWhenAdded>
			</li>
			<li Class="PoniesOfTheRim.Thoughts.ThoughtExtension">
				<race>Pony_Alicorn</race>
			</li>
		</modExtensions>
	</ThoughtDef>

</Defs>