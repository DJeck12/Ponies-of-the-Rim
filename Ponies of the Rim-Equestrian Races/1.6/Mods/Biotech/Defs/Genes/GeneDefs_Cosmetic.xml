	<GeneDef ParentName="GenePonyBase">
		<defName>Pony_SoulGem</defName>
		<label>soul gem</label>
		<description>Carriers of this gene have a teardrop-shaped gemstone on their chest. This organ is used by changelings to store the remembered forms of other creatures for shapeshifting.</description>
		<iconPath>UI/Genes/SoulGem</iconPath>
		<displayOrderInCategory>70</displayOrderInCategory>
		<biostatCpx>0</biostatCpx>
	</GeneDef>

