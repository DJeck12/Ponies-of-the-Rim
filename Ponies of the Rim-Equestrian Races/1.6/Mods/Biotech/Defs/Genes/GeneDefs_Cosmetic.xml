<?xml version="1.0" encoding="UTF-8"?>
<Defs>

<!-- Head -->

	<GeneDef ParentName="GenePonyBase">
		<defName>Pony_GriffonBeak</defName>
		<label>beak</label>
		<description>Carriers of this gene have a bird-like beak on their mouth, which does not interfere with eating or communication.</description>
		<iconPath>UI/Genes/GriffonBeak</iconPath>
		<displayOrderInCategory>40</displayOrderInCategory>
		<biostatCpx>0</biostatCpx>
		<forcedHeadTypes>
			<li>Male_Pony</li>
			<li>Female_Pony</li>
		</forcedHeadTypes>
		<exclusionTags>
			<li>Head</li>
			<li>HeadType</li>
		</exclusionTags>
	</GeneDef>

	<GeneDef ParentName="GenePonyBase">
		<defName>Pony_DeerNose</defName>
		<label>deer nose</label>
		<description>Carriers of this gene have a deer-like nose.</description>
		<iconPath>UI/Genes/DeerNose</iconPath>
		<displayOrderInCategory>41</displayOrderInCategory>
		<prerequisite>Pony_EquineHead</prerequisite>
		<biostatCpx>0</biostatCpx>
		<exclusionTags>
			<li>Nose</li>
		</exclusionTags>
	</GeneDef>

	<GeneDef ParentName="GenePonyBase">
		<defName>Pony_DeerAntlers</defName>
		<label>antlers</label>
		<description>Carriers of this gene grow a pair of branched antlers on their head.</description>
		<iconPath>UI/Genes/Antlers</iconPath>
		<displayOrderInCategory>43</displayOrderInCategory>
		<iconColor>(0.75, 0.75, 0.75)</iconColor>
		<biostatCpx>0</biostatCpx>
	</GeneDef>

<!-- Body -->

	<GeneDef ParentName="GenePonyBase">
		<defName>Pony_Bodymark</defName>
		<label>bodymark</label>
		<description>Carriers of this gene have a natural small picture-like symbol on their waist depicting their personality, talents or interests. Unlike cutiemarks, bodymarks have more abstract patterns and are similar to religious tattoos.</description>
		<iconPath>UI/Genes/Bodymark</iconPath>
		<displayOrderInCategory>60</displayOrderInCategory>
		<biostatCpx>0</biostatCpx>
		<exclusionTags>
			<li>Cutiemark</li>
		</exclusionTags>
	</GeneDef>

	<GeneDef ParentName="GenePonyBase">
		<defName>Pony_Carapace</defName>
		<label>carapace</label>
		<description>Carriers of this gene grow dragon scales on their back.</description>
		<iconPath>UI/Genes/Carapace</iconPath>
		<displayOrderInCategory>65</displayOrderInCategory>
		<biostatCpx>0</biostatCpx>
		<exclusionTags>
			<li>BodyCover</li>
		</exclusionTags>
	</GeneDef>

	<GeneDef ParentName="GenePonyBase">
		<defName>Pony_Chitin</defName>
		<label>chitin</label>
		<description>Carriers of this gene have an exoskeleton made of chitin instead of skin.</description>
		<iconPath>UI/Genes/Chitin</iconPath>
		<displayOrderInCategory>65</displayOrderInCategory>
		<biostatCpx>0</biostatCpx>
		<exclusionTags>
			<li>BodyCover</li>
		</exclusionTags>
	</GeneDef>
