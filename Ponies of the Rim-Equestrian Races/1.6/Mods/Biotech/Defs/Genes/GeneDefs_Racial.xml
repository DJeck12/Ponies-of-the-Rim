<?xml version="1.0" encoding="UTF-8"?>
<Defs>

	<GeneDef ParentName="GenePonyBase">
		<defName>Pony_Nocturnal</defName>
		<label>nocturnal</label>
		<description>Carriers of this gene prefer to be up at night. They are happier if awake at nights and unhappy if awake during the day.</description>
		<iconPath>UI/Genes/Nocturnal</iconPath>
		<iconColor>(0.75, 0.75, 0.75)</iconColor>
		<displayOrderInCategory>50</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<forcedTraits>
			<li>
				<def>NightOwl</def>
			</li>
		</forcedTraits>
		<symbolPack>
			<prefixSymbols>
				<li><symbol>horse</symbol></li>
				<li><symbol>pon</symbol></li>
				<li><symbol>bat</symbol></li>
			</prefixSymbols>
			<suffixSymbols>
				<li><symbol>neigh</symbol></li>
				<li><symbol>pony</symbol></li>
			</suffixSymbols>
		</symbolPack>
	</GeneDef>

	<GeneDef ParentName="GenePonyBase">
		<defName>Pony_CrystallineSkin</defName>
		<label>crystalline skin</label>
		<description>The skin of carriers of this gene takes on a crystallized form, shimmering in the light and making it resistant to blunt damage of any kind.</description>
		<iconPath>UI/Genes/CrystallineSkin</iconPath>
		<iconColor>(0.75, 0.75, 0.75)</iconColor>
		<biostatCpx>0</biostatCpx>
		<biostatMet>-1</biostatMet>
		<statOffsets>
			<ArmorRating_Blunt>0.2</ArmorRating_Blunt>
		</statOffsets>
	</GeneDef>

	<GeneDef ParentName="GenePonyBase">
		<defName>Pony_Oviparous</defName>
		<label>oviparous</label>
		<description>Carriers of this gene lay eggs instead of giving live birth. Eggs need time and correct conditions to hatch.</description>
		<iconPath>UI/Genes/Oviparous</iconPath>
		<iconColor>(0.75, 0.75, 0.75)</iconColor>
		<biostatCpx>0</biostatCpx>
		<biostatMet>-1</biostatMet>
		<exclusionTags>
			<li>Egglaying</li>
		</exclusionTags>
		<customEffectDescriptions>
			<li>Lays eggs instead of pregnancy and live birth.</li>
			<li>Laying eggs makes the pawn temporarily infertile.</li>
		</customEffectDescriptions>
	</GeneDef>

	<GeneDef ParentName="GenePonyBase">
		<defName>Pony_BirdHands</defName>
		<label>bird talons</label>
		<description>Carriers of this gene have hands that resemble bird feet. Their sharp claws allow them to deal sharp damage instead of blunt when unarmed in compensation of manipulation capability.</description>
		<iconPath>UI/Genes/BirdHands</iconPath>
		<iconColor>(0.75, 0.75, 0.75)</iconColor>
		<displayOrderInCategory>25</displayOrderInCategory>
		<biostatCpx>1</biostatCpx>
		<biostatMet>1</biostatMet>
		<capMods>
			<li>
				<capacity>Manipulation</capacity>
				<postFactor>0.95</postFactor>
			</li>
		</capMods>
		<symbolPack>
			<wholeNameSymbols>
				<li><symbol>avian</symbol></li>
			</wholeNameSymbols>
			<prefixSymbols>
				<li><symbol>bird</symbol></li>
				<li><symbol>grif</symbol></li>
				<li><symbol>sharp</symbol></li>
			</prefixSymbols>
			<suffixSymbols>
				<li><symbol>claw</symbol></li>
				<li><symbol>hook</symbol></li>
				<li><symbol>predator</symbol></li>
			</suffixSymbols>
		</symbolPack>
		<exclusionTags>
			<li>Hands</li>
		</exclusionTags>
		<modExtensions>
			<li Class="VEF.Genes.GeneExtension">
				<hediffsToBodyParts>
					<li>
						<hediff>Pony_BirdHands</hediff>
						<bodyparts>
							<li>Hand</li>
							<li>Hand</li>
						</bodyparts>
					</li>
				</hediffsToBodyParts>
			</li>
		</modExtensions>
	</GeneDef>

</Defs>