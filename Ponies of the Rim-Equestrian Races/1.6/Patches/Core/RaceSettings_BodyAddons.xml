		<xpath>Defs/AlienRace.RaceSettings[defName="Pony_BodyAddons_Settings"]/universalBodyAddons/li[name="Cutiemark"]/extendedGraphics/Mutant[1]</xpath>
		<order>Append</order>
		<value>
			<Race For="Pony_Zebra">Races/Cutiemarks/QTMark_Zebra</Race>
		</value>
	</Operation>

