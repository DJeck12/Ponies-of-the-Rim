	<Operation Class="PatchOperationConditional">
		<xpath>Defs/AlienRace.RaceSettings[defName="Pony_BodyAddons_Settings"]/universalBodyAddons/li[name="Cutiemark"]/conditions/Or[1]/Race[text()="Pony_Earthpony"]</xpath>
		<match Class="PatchOperationAdd">
			<xpath>Defs/AlienRace.RaceSettings[defName="Pony_BodyAddons_Settings"]/universalBodyAddons/li[name="Cutiemark"]/conditions/Or[1]</xpath>
			<value>
				<Race>Pony_Alicorn</Race>
				<Race>Pony_Batpony</Race>
				<Race>Pony_Crystalpony</Race>
				<Race>Pony_Zebra</Race>
			</value>
		</match>
	</Operation>
