<?xml version="1.0" encoding="UTF-8"?>
<Patch>

	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Biotech</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationReplace">
					<xpath>Defs/AlienRace.ThingDef_AlienRace[defName="Pony_Alicorn"
					or defName="Pony_Batpony"
					or defName="Pony_Changeling"
					or defName="Pony_Changedling"
					or defName="Pony_Crystalpony"
					or defName="Pony_Deer"
					or defName="Pony_Griffon"
					or defName="Pony_Hippogriff"
					or defName="Pony_Kirin"
					or defName="Pony_Zebra"]/statBases</xpath>
					<value>
						<statBases>
							<MarketValue>1800</MarketValue>
							<MoveSpeed>4.6</MoveSpeed>
							<PsychicSensitivity>1.1</PsychicSensitivity>
							<ComfyTemperatureMin>16</ComfyTemperatureMin>
							<ComfyTemperatureMax>26</ComfyTemperatureMax>
							<CarryingCapacity>80</CarryingCapacity>
							<Mass>55</Mass>
							<PainShockThreshold>0.75</PainShockThreshold>
							<RoyalFavorValue>4</RoyalFavorValue>
						</statBases>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>Defs/AlienRace.ThingDef_AlienRace[defName="Pony_Deer"]/alienRace/styleSettings/li[key="HairDef"]/value/hasStyle</xpath>
					<value>
						<hasStyle>true</hasStyle>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>Defs/AlienRace.ThingDef_AlienRace[defName="Pony_Changeling"
					or defName="Pony_Changedling"]/alienRace/styleSettings/li[key="BeardDef"]/value/hasStyle</xpath>
					<value>
						<hasStyle>true</hasStyle>
					</value>
				</li>
				<li Class="PatchOperationRemove">
					<xpath>Defs/AlienRace.ThingDef_AlienRace[defName="Pony_Changeling"
					or defName="Pony_Changedling"]/alienRace/generalSettings/alienPartGenerator/oldHairAgeCurve</xpath>
				</li>
			</operations>
		</match>
	</Operation>

</Patch>