<?xml version="1.0" encoding="UTF-8"?>
<Patch>

	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Biotech</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationReplace">
					<xpath>Defs/AlienRace.ThingDef_AlienRace[defName="Pony_Deer"]/alienRace/styleSettings/li[key="HairDef"]/value/hasStyle</xpath>
					<value>
						<hasStyle>true</hasStyle>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>Defs/AlienRace.ThingDef_AlienRace[defName="Pony_Changeling"
					or defName="Pony_Changedling"]/alienRace/styleSettings/li[key="BeardDef"]/value/hasStyle</xpath>
					<value>
						<hasStyle>true</hasStyle>
					</value>
				</li>
				<li Class="PatchOperationRemove">
					<xpath>Defs/AlienRace.ThingDef_AlienRace[defName="Pony_Changeling"
					or defName="Pony_Changedling"]/alienRace/generalSettings/alienPartGenerator/oldHairAgeCurve</xpath>
				</li>
			</operations>
		</match>
	</Operation>

</Patch>