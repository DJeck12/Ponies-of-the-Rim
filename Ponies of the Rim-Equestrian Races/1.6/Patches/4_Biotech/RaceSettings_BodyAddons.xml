				<li Class="PatchOperationReplace">
					<xpath>Defs/AlienRace.RaceSettings[defName="Pony_BodyAddons_Settings"]/universalBodyAddons/li[name="Head"]/extendedGraphics/Race[@For="Pony_Deer"]</xpath>
