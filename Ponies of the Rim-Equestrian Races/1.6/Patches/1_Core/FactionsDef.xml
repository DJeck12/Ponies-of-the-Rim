<?xml version="1.0" encoding="UTF-8"?>
<Patch>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/FactionDef[@Name="PonyOutlanderFactionBase"]</xpath>
		<value>
			<fixedLeaderKinds>
				<li>Pony_AlicornTown_Councilman</li>
			</fixedLeaderKinds>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/FactionDef[defName="Pony_BatponyKingdom"]/modExtensions/li[@Class="PoniesOfTheRim.CommsConsoleExtension"]</xpath>
		<value>
			<texts>
				<li>
					<questionText>Ask about their origin</questionText>
					<answerText>temp</answerText>
				</li>
			</texts>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/FactionDef[not(@Abstract="True")]/modExtensions[not(@Class="VEF.Factions.FactionDefExtension")]</xpath>
		<value>
			<li Class="VEF.Factions.FactionDefExtension" />
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/FactionDef[not(@Abstract="True")]/modExtensions/li[@Class="VEF.Factions.FactionDefExtension" and not(startingGoodwillByFactionDefs)]</xpath>
		<value>
			<startingGoodwillByFactionDefs />
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/FactionDef[not(@Abstract="True")]/modExtensions/li[@Class="VEF.Factions.FactionDefExtension"]/startingGoodwillByFactionDefs</xpath>
		<value>
			<Pony_PlayerChangelingHive>-80</Pony_PlayerChangelingHive>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/FactionDef[defName="Pony_ChangelingHive"]/modExtensions/li[@Class="VEF.Factions.FactionDefExtension"]/startingGoodwillByFactionDefs/Pony_PlayerChangelingHive</xpath>
		<value>
			<Pony_PlayerChangelingHive>0</Pony_PlayerChangelingHive>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/FactionDef[@Name="PonyOutlanderFactionBase"]/pawnGroupMakers/li[2]/options</xpath>
		<value>
			<Pony_BatponyVillager_Child MayRequire="Ludeon.RimWorld.Biotech">10</Pony_BatponyVillager_Child>
		</value>
	</Operation>

</Patch>