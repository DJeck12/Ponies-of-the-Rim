<?xml version="1.0" encoding="UTF-8"?>
<Patch>

	<Operation Class="PoniesOfTheRim.PatchOperation.PatchOperationToggleableSequence">
		<settingId>HumanoidStats</settingId>
		<label>Human stats</label>
		<description>Changes stats of ponies to match human stats</description>
		<defaultState>false</defaultState>
		<operations>
			<li Class="PatchOperationReplace">
				<xpath>Defs/AlienRace.ThingDef_AlienRace[defName="Pony_Earthpony"
				or defName="Pony_Pegasus"
				or defName="Pony_Unicorn"]/statBases</xpath>
				<value>
					<statBases>
						<MarketValue>1750</MarketValue>
						<MoveSpeed>4.6</MoveSpeed>
						<PsychicSensitivity>1</PsychicSensitivity>
						<ImmunityGainSpeed>1</ImmunityGainSpeed>
						<ComfyTemperatureMin>16</ComfyTemperatureMin>
						<ComfyTemperatureMax>26</ComfyTemperatureMax>
						<CarryingCapacity>75</CarryingCapacity>
						<Mass>60</Mass>
						<PainShockThreshold>0.80</PainShockThreshold>
						<AimingDelayFactor>1</AimingDelayFactor>
						<PawnBeauty>0</PawnBeauty>
						<WorkSpeedGlobal>1</WorkSpeedGlobal>
					</statBases>
				</value>
			</li>
		</operations>
	</Operation>

</Patch>