		  <li Class="PoniesOfTheRim.Flying.CompProperties_PegasusWingsRenderer" />
		  <li Class="PoniesOfTheRim.Flying.CompPropertiesPegasusFlightToggle" />
		  <li Class="PoniesOfTheRim.Flying.CompPropertiesPegasusFlightTimer" />
		  <li Class="PoniesOfTheRim.Flying.CompProperties_PegasusAI" />
		</comps>
		<statBases>
			<MarketValue>1800</MarketValue>
			<MoveSpeed>4.6</MoveSpeed>
			<PsychicSensitivity>1.1</PsychicSensitivity>
			<ComfyTemperatureMin>12</ComfyTemperatureMin> <!-- Will be replaced with a gene with Biotech. Defaults to 16 -->
