<?xml version="1.0" encoding="UTF-8"?>
<Defs>

	<RecipeDef ParentName="CookMealFineBase">
		<defName>Pony_CookMealFine_Hay</defName>
		<label>cook hay fine meal</label>
		<description>Cook a somewhat complex meal from plant ingredients and hay. Suitable for creatures with a predominantly vegetarian diet.</description>
		<jobString>Cooking hay fine meal.</jobString>
		<recipeUsers>
			<li>ElectricStove</li>
			<li>FueledStove</li>
		</recipeUsers>
		<ingredients>
			<li>
				<filter>
					<customSummary>vegetarian ingredients</customSummary>
					<categories>
						<li>PlantFoodRaw</li>
						<li>AnimalProductRaw</li>
					</categories>
				</filter>
				<count>0.25</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Hay</li>
					</thingDefs>
				</filter>
				<count>0.25</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<disallowedCategories>
				<li>MeatRaw</li>
			</disallowedCategories>
			<thingDefs>
				<li>Hay</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Pony_MealFine_Hay>1</Pony_MealFine_Hay>
		</products>
	</RecipeDef>

