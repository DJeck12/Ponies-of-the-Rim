<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <HediffDef>
    <defName>Pony_FlightFatigue</defName>
    <label>flight fatigue</label>
    <description>Exhaustion from prolonged flight. Depleted stamina impairs consciousness and increases the need for rest.</description>
    <hediffClass>Verse.Hediff</hediffClass>
    <defaultLabelColor>(0.9, 0.6, 0.1)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1.0</maxSeverity>
    <stages>

      <li>
        <minSeverity>0</minSeverity>
        <label>tired</label>
      </li>

      <li>
        <minSeverity>0.5</minSeverity>
        <label>exhausted</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>

      <li>
        <minSeverity>0.75</minSeverity>
        <label>critically exhausted</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.15</offset>
          </li>
        </capMods>
      </li>

    </stages>
  </HediffDef>

</Defs>