<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- === Корпус === -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/BodyDef[starts-with(defName, "Pony_")]/corePart/groups</xpath>
    <value>
      <li>CoveredByNaturalArmor</li>
    </value>
  </Operation>


  <!-- === Все внешние части: голова, шея, ноги, копыта, крылья, рога, когти, лапы, клюв, хвост, глаза, уши === -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/BodyDef[starts-with(defName, "Pony_")]//li[def][not(depth="Inside")]/groups</xpath>
    <value>
      <li>CoveredByNaturalArmor</li>
    </value>
  </Operation>


  <!-- === Плечи === -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/BodyDef[starts-with(defName, "Pony_")]//li[customLabel="left shoulder"]/groups</xpath>
    <value>
      <li>LeftShoulder</li>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/BodyDef[starts-with(defName, "Pony_")]//li[customLabel="right shoulder"]/groups</xpath>
    <value>
      <li>RightShoulder</li>
    </value>
  </Operation>


  <!-- === Передние ноги -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/BodyDef[starts-with(defName, "Pony_")]//li[customLabel="front left leg"]/groups</xpath>
    <value>
      <li>LeftArm</li>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/BodyDef[starts-with(defName, "Pony_")]//li[customLabel="front right leg"]/groups</xpath>
    <value>
      <li>RightArm</li>
    </value>
  </Operation>
  
    <!-- Когти грифонов и гиппогрифов ToolCE -->
<Operation Class="PatchOperationConditional">
	<xpath>/Defs/HediffDef[defName="Pony_BirdTalons"]/comps/li[@Class="HediffCompProperties_VerbGiver"]/tools/li</xpath>
	<match Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationAttributeSet">
				<xpath>/Defs/HediffDef[defName="Pony_BirdTalons"]/comps/li[@Class="HediffCompProperties_VerbGiver"]/tools/li</xpath>
				<attribute>Class</attribute>
				<value>CombatExtended.ToolCE</value>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>/Defs/HediffDef[defName="Pony_BirdTalons"]/comps/li[@Class="HediffCompProperties_VerbGiver"]/tools/li</xpath>
				<value>
					<armorPenetrationSharp>0.4</armorPenetrationSharp>
					<armorPenetrationBlunt>1.2</armorPenetrationBlunt>
				</value>
			</li>
		</operations>
	</match>
</Operation>

</Patch>